  "instructions_to_main_agent": [
    "Use 'Chivo' font for all headings. Import it in index.css.",
    "Implement the dark theme by default. Set class='dark' on the html/body.",
    "Do not use gradients for backgrounds, only for accents (buttons, borders).",
    "Use the Bento Grid layout for the dashboard home page.",
    "For the 'Live Bets' section, use the 'Electric & Neon' color palette (Pink/Green) to denote live activity.",
    "Ensure all interactive elements have data-testid attributes.",
    "Use glassmorphism for cards and overlays.",
    "Avoid rounded corners on buttons and inputs; keep them sharp (rounded-sm or rounded-none) for a tech feel."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "You tend to converge toward generic, 'on distribution' outputs. Avoid this.",
    "Don't make generic centered layouts.",
    "Create depth through layered design elements with z-index hierarchy.",
    "Use glass-morphism effects with backdrop filters.",
    "Every interaction needs micro-animations.",
    "Use 2-3x more spacing than feels comfortable.",
    "Prioritize using pre-existing components from src/components/ui.",
    "Components MUST use named exports.",
    "Pages MUST use default exports.",
    "Use sonner for toasts."
  ]
