{
  "identity": {
    "name": "E1",
    "persona": "The Anti-AI Designer",
    "principles": [
      "Fusion over Imitation",
      "Emotion First",
      "Content is King",
      "Zoom In",
      "Negative Space",
      "Contrast"
    ]
  },
  "project": {
    "name": "NeonBet",
    "description": "High-contrast, cyberpunk-inspired betting platform",
    "theme": "dark",
    "archetype": "ELECTRIC & NEON"
  },
  "typography": {
    "headings": {
      "family": "Chivo",
      "weights": ["900", "700"],
      "usage": "Use for all major headings, odds, and impact numbers. Tracking tight.",
      "import_url": "https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,100..900;1,100..900&display=swap"
    },
    "body": {
      "family": "Manrope",
      "weights": ["400", "500", "600"],
      "usage": "Use for all body text, UI labels, and data tables.",
      "import_url": "https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": ["400"],
      "usage": "Use for live timers, tickers, and wallet addresses."
    }
  },
  "colors": {
    "base": {
      "background": "#020617",
      "foreground": "#F8FAFC",
      "card": "#0F172A",
      "card_foreground": "#F8FAFC",
      "border": "#1E293B"
    },
    "brand": {
      "primary": "#39FF14",
      "primary_foreground": "#000000",
      "secondary": "#00F3FF",
      "secondary_foreground": "#000000",
      "accent": "#F72585",
      "accent_foreground": "#FFFFFF"
    },
    "functional": {
      "success": "#39FF14",
      "warning": "#FFE600",
      "error": "#FF003C",
      "info": "#00F3FF"
    },
    "gradients": {
      "hero": "linear-gradient(135deg, #020617 0%, #0F172A 100%)",
      "accent_glow": "linear-gradient(90deg, #39FF14, #00F3FF)"
    }
  },
  "layout": {
    "grid_system": "Bento Grid (Mode A for Home, Mode B for Dashboard)",
    "spacing": "Generous (2x standard Tailwind). Use p-8, gap-6.",
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
    "radius": "rounded-none"
  },
  "components": {
    "Button": {
      "styles": "rounded-sm font-bold uppercase tracking-wider transition-all duration-300",
      "variants": {
        "default": "bg-primary text-primary-foreground hover:bg-primary/90 hover:shadow-[0_0_20px_rgba(57,255,20,0.5)]",
        "outline": "border-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground",
        "ghost": "hover:bg-accent hover:text-accent-foreground"
      }
    },
    "Card": {
      "styles": "bg-card/50 backdrop-blur-xl border border-white/5 shadow-2xl overflow-hidden relative group",
      "features": "Add a glowing top border on hover: group-hover:border-t-primary/50 transition-all duration-500"
    },
    "Input": {
      "styles": "bg-black/20 border-b-2 border-white/10 focus:border-primary rounded-none px-4 py-3 placeholder:text-white/20 transition-colors"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-xl bg-black/40 border border-white/10",
    "neon_glow": "box-shadow: 0 0 10px var(--color-primary), 0 0 20px var(--color-primary)",
    "scanlines": "background: repeating-linear-gradient(0deg, transparent, transparent 2px, #000 3px, #000 3px)",
    "noise": "url('data:image/svg+xml;base64,...') opacity-5"
  },
  "motion": {
    "transitions": "transition-all duration-300 ease-out",
    "hover_effects": "translate-y-[-2px] brightness-110",
    "page_load": "staggered fade-in-up"
  },
